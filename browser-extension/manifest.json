{
  "manifest_version": 3,
  "name": "Fetchflow Download Catcher",
  "version": "1.10.0",
  "key": "",
  "description": "Route Chrome downloads through Fetchflow with a save-path confirmation.",
  "permissions": ["downloads", "contextMenus", "storage", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["click-capture.js", "video-overlay.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {
    "default_title": "Fetchflow Download Catcher",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "48": "icon.png" }
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}

